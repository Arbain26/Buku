generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                     @id @default(autoincrement())
  name               String
  email              String                  @unique
  password           String
  phone              String?
  role               Role                    @default(USER)
  avatar             String?
  bio                String?                 @db.Text
  isActive           Boolean                 @default(true)
  locationAddress    String?
  district           String?
  latitude           Float?
  longitude          Float?
  points             Int                     @default(0)
  level              String                  @default("Pembaca Pemula")
  deletedAt          DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  articles           Article[]
  borrowings         Borrowing[]
  communityJoins     CommunityMember[]
  eventJoins         EventParticipant[]
  mitraProfile       MitraProfile?
  notifications      Notification[]
  orders             Order[]
  pointRecord        Point?
  reviews            Review[]
  activities         UserActivity[]
  articleFavorites   UserArticleFavorite[]
  bookFavorites      UserBookFavorite[]
  communityFavorites UserCommunityFavorite[]
  eventFavorites     UserEventFavorite[]
  libraryFavorites   UserLibraryFavorite[]
  userMissions       UserMission[]
  storeFavorites     UserStoreFavorite[]

  @@index([email])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model MitraProfile {
  id               Int         @id @default(autoincrement())
  userId           Int         @unique
  mitraType        MitraType
  organizationName String
  slug             String      @unique
  description      String      @db.Text
  address          String      @db.Text
  district         String
  village          String?
  latitude         Float
  longitude        Float
  phoneWa          String
  logo             String?
  banner           String?
  status           MitraStatus @default(PENDING)
  rejectionReason  String?     @db.Text
  openHours        String?
  verifiedAt       DateTime?
  deletedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  community        Community?
  events           Event[]
  library          Library?
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  store            Store?

  @@index([mitraType])
  @@index([status])
  @@index([district])
  @@map("mitra_profiles")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  books       Book[]

  @@index([slug])
  @@map("categories")
}

model Author {
  id          Int          @id @default(autoincrement())
  name        String
  slug        String?      @unique
  bio         String?      @db.Text
  avatar      String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  bookAuthors BookAuthor[]

  @@map("authors")
}

model BookAuthor {
  id       Int    @id @default(autoincrement())
  bookId   Int
  authorId Int
  author   Author @relation(fields: [authorId], references: [id], onDelete: Cascade)
  book     Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, authorId])
  @@index([bookId])
  @@index([authorId])
  @@map("book_authors")
}

model Book {
  id                 Int                 @id @default(autoincrement())
  title              String
  slug               String              @unique
  author             String
  publisher          String?
  isbn               String?             @unique
  publishYear        Int?
  pages              Int?
  language           String?             @default("Bahasa Indonesia")
  description        String              @db.Text
  coverImage         String?
  rating             Float               @default(0)
  reviewCount        Int                 @default(0)
  categoryId         Int
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  bookAuthors        BookAuthor[]
  category           Category            @relation(fields: [categoryId], references: [id])
  borrowings         Borrowing[]
  libraryCollections LibraryCollection[]
  orderItems         OrderItem[]
  reviews            Review[]
  storeProducts      StoreProduct[]
  favorites          UserBookFavorite[]

  @@index([title])
  @@index([slug])
  @@index([isbn])
  @@index([categoryId])
  @@index([createdAt])
  @@map("books")
}

model Store {
  id             Int                 @id @default(autoincrement())
  mitraId        Int                 @unique
  name           String
  slug           String              @unique
  description    String?             @db.Text
  address        String              @db.Text
  district       String?
  village        String?
  phone          String?
  whatsappNumber String
  latitude       Float?
  longitude      Float?
  image          String?
  banner         String?
  openHours      String?
  isActive       Boolean             @default(true)
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  orders         Order[]
  reviews        Review[]
  products       StoreProduct[]
  mitra          MitraProfile        @relation(fields: [mitraId], references: [id], onDelete: Cascade)
  favorites      UserStoreFavorite[]

  @@index([name])
  @@index([district])
  @@index([isActive])
  @@map("stores")
}

model StoreProduct {
  id          Int         @id @default(autoincrement())
  storeId     Int
  bookId      Int
  price       Decimal     @db.Decimal(12, 2)
  stock       Int         @default(0)
  condition   String      @default("BARU")
  isAvailable Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  book        Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, bookId])
  @@index([storeId])
  @@index([bookId])
  @@map("store_products")
}

model Library {
  id           Int                   @id @default(autoincrement())
  mitraId      Int                   @unique
  name         String
  slug         String                @unique
  description  String?               @db.Text
  address      String                @db.Text
  district     String?
  village      String?
  phone        String?
  latitude     Float?
  longitude    Float?
  image        String?
  banner       String?
  openingHours String?
  isActive     Boolean               @default(true)
  deletedAt    DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  borrowings   Borrowing[]
  mitra        MitraProfile          @relation(fields: [mitraId], references: [id], onDelete: Cascade)
  collections  LibraryCollection[]
  reviews      Review[]
  favorites    UserLibraryFavorite[]

  @@index([name])
  @@index([district])
  @@index([isActive])
  @@map("libraries")
}

model LibraryCollection {
  id                Int         @id @default(autoincrement())
  libraryId         Int
  bookId            Int
  callNumber        String?
  quantity          Int         @default(1)
  availableQuantity Int         @default(1)
  shelfLocation     String?
  category          String?
  isAvailable       Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  borrowings        Borrowing[]
  book              Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  library           Library     @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@unique([libraryId, bookId])
  @@index([libraryId])
  @@index([bookId])
  @@map("library_collections")
}

model Community {
  id          Int                     @id @default(autoincrement())
  mitraId     Int                     @unique
  name        String
  slug        String                  @unique
  description String?                 @db.Text
  logo        String?
  coverImage  String?
  address     String?                 @db.Text
  district    String?
  village     String?
  latitude    Float?
  longitude   Float?
  contact     String?
  isActive    Boolean                 @default(true)
  deletedAt   DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  mitra       MitraProfile            @relation(fields: [mitraId], references: [id], onDelete: Cascade)
  members     CommunityMember[]
  reviews     Review[]
  favorites   UserCommunityFavorite[]

  @@index([name])
  @@index([district])
  @@index([isActive])
  @@map("communities")
}

model CommunityMember {
  id          Int       @id @default(autoincrement())
  communityId Int
  userId      Int
  role        String    @default("ANGGOTA")
  status      String    @default("ACTIVE")
  joinedAt    DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId])
  @@index([userId])
  @@map("community_members")
}

model Event {
  id                   Int                 @id @default(autoincrement())
  organizerMitraId     Int
  title                String
  slug                 String              @unique
  description          String              @db.Text
  image                String?
  category             EventCategory       @default(DISKUSI)
  audience             AudienceType        @default(UMUM)
  location             String
  address              String?             @db.Text
  district             String?
  latitude             Float?
  longitude            Float?
  eventDate            DateTime
  startTime            String
  endTime              String
  capacity             Int                 @default(50)
  currentParticipants  Int                 @default(0)
  registrationDeadline DateTime?
  isFree               Boolean             @default(true)
  price                Decimal?            @db.Decimal(10, 2)
  status               EventStatus         @default(PUBLISHED)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  participants         EventParticipant[]
  organizer            MitraProfile        @relation(fields: [organizerMitraId], references: [id], onDelete: Cascade)
  reviews              Review[]
  favorites            UserEventFavorite[]

  @@index([slug])
  @@index([status])
  @@index([eventDate])
  @@index([category])
  @@index([organizerMitraId])
  @@map("events")
}

model EventParticipant {
  id           Int       @id @default(autoincrement())
  eventId      Int
  userId       Int
  status       String    @default("REGISTERED")
  registeredAt DateTime  @default(now())
  attendedAt   DateTime?
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_participants")
}

model ArticleCategory {
  id        Int                       @id @default(autoincrement())
  name      String                    @unique
  slug      String                    @unique
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  articles  ArticleCategoryRelation[]

  @@map("article_categories")
}

model Article {
  id          Int                       @id @default(autoincrement())
  authorId    Int
  title       String
  slug        String                    @unique
  thumbnail   String?
  excerpt     String                    @db.Text
  content     String                    @db.LongText
  readingTime Int                       @default(5)
  views       Int                       @default(0)
  isFeatured  Boolean                   @default(false)
  status      String                    @default("PUBLISHED")
  publishedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  categories  ArticleCategoryRelation[]
  author      User                      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  favorites   UserArticleFavorite[]

  @@index([slug])
  @@index([status])
  @@index([authorId])
  @@index([createdAt])
  @@map("articles")
}

model ArticleCategoryRelation {
  id         Int             @id @default(autoincrement())
  articleId  Int
  categoryId Int
  article    Article         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category   ArticleCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([articleId, categoryId])
  @@index([articleId])
  @@index([categoryId])
  @@map("article_category_relations")
}

model Review {
  id          Int        @id @default(autoincrement())
  userId      Int
  bookId      Int?
  storeId     Int?
  libraryId   Int?
  communityId Int?
  eventId     Int?
  rating      Int
  comment     String     @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  book        Book?      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  community   Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  event       Event?     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  library     Library?   @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  store       Store?     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookId])
  @@index([storeId])
  @@index([libraryId])
  @@index([communityId])
  @@index([eventId])
  @@map("reviews")
}

model UserBookFavorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  bookId    Int
  createdAt DateTime @default(now())
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@map("user_book_favorites")
}

model UserStoreFavorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  storeId   Int
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([userId])
  @@index([storeId])
  @@map("user_store_favorites")
}

model UserLibraryFavorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  libraryId Int
  createdAt DateTime @default(now())
  library   Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, libraryId])
  @@index([userId])
  @@index([libraryId])
  @@map("user_library_favorites")
}

model UserCommunityFavorite {
  id          Int       @id @default(autoincrement())
  userId      Int
  communityId Int
  createdAt   DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([userId])
  @@index([communityId])
  @@map("user_community_favorites")
}

model UserEventFavorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  eventId   Int
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("user_event_favorites")
}

model UserArticleFavorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  articleId Int
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
  @@map("user_article_favorites")
}

model Borrowing {
  id           Int                @id @default(autoincrement())
  userId       Int
  libraryId    Int
  bookId       Int
  collectionId Int?
  quantity     Int                @default(1)
  requestedAt  DateTime           @default(now())
  approvedAt   DateTime?
  borrowedAt   DateTime?
  dueDate      DateTime
  returnedAt   DateTime?
  status       BorrowStatus       @default(PENDING)
  notes        String?            @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  book         Book               @relation(fields: [bookId], references: [id], onDelete: Cascade)
  collection   LibraryCollection? @relation(fields: [collectionId], references: [id])
  library      Library            @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([libraryId])
  @@index([bookId])
  @@index([status])
  @@index([collectionId], map: "borrowings_collectionId_fkey")
  @@map("borrowings")
}

model Order {
  id              Int         @id @default(autoincrement())
  userId          Int?
  storeId         Int
  orderNumber     String      @unique
  totalAmount     Decimal     @db.Decimal(12, 2)
  status          OrderStatus @default(PENDING)
  customerName    String
  customerPhone   String
  customerAddress String?     @db.Text
  notes           String?     @db.Text
  waMessageSent   Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
  store           Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user            User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([storeId])
  @@index([orderNumber])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id             Int           @id @default(autoincrement())
  orderId        Int
  bookId         Int
  storeProductId Int?
  quantity       Int           @default(1)
  price          Decimal       @db.Decimal(12, 2)
  subtotal       Decimal       @db.Decimal(12, 2)
  book           Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeProduct   StoreProduct? @relation(fields: [storeProductId], references: [id])

  @@index([orderId])
  @@index([bookId])
  @@index([storeProductId], map: "order_items_storeProductId_fkey")
  @@map("order_items")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  title     String
  message   String    @db.Text
  type      String    @default("INFO")
  isRead    Boolean   @default(false)
  linkUrl   String?
  data      String?   @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model Point {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  totalPoints Int      @default(0)
  level       String   @default("Pembaca Pemula")
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("points")
}

model Mission {
  id           Int           @id @default(autoincrement())
  title        String
  description  String        @db.Text
  points       Int           @default(10)
  target       Int           @default(1)
  type         String        @default("DAILY")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userMissions UserMission[]

  @@map("missions")
}

model UserMission {
  id          Int       @id @default(autoincrement())
  userId      Int
  missionId   Int
  progress    Int       @default(0)
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  mission     Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@index([userId])
  @@index([missionId])
  @@map("user_missions")
}

model UserActivity {
  id           Int      @id @default(autoincrement())
  userId       Int
  activityType String
  referenceId  Int?
  pointsEarned Int      @default(0)
  description  String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activityType])
  @@map("user_activities")
}

model Location {
  id        Int      @id @default(autoincrement())
  province  String   @default("Sulawesi Selatan")
  regency   String   @default("Sidenreng Rappang")
  district  String
  village   String?
  address   String?  @db.Text
  latitude  Decimal  @db.Decimal(10, 8)
  longitude Decimal  @db.Decimal(11, 8)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([district])
  @@map("locations")
}

enum Role {
  USER
  MITRA
  ADMIN
}

enum MitraType {
  TOKO_BUKU
  PERPUSTAKAAN
  KOMUNITAS
  SEKOLAH
  PENGAJAR
}

enum MitraStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum EventCategory {
  BEDAH_BUKU
  DISKUSI
  LAPAK_BACA
  KELAS_MENULIS
  PELATIHAN
  PAMERAN
  FESTIVAL_LITERASI
}

enum AudienceType {
  ANAK
  REMAJA
  DEWASA
  UMUM
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

enum BorrowStatus {
  PENDING
  APPROVED
  BORROWED
  RETURNED
  REJECTED
  OVERDUE
}

enum OrderStatus {
  PENDING
  CONTACTED
  CONFIRMED
  COMPLETED
  CANCELLED
}
